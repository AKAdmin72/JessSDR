h 0) (type default)) (uuid "10c818cf-4b33-588b-86f8-d6f51429172d")) (symbol (lib_id "power:GND") (at 20.32 233.68 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "7ea69630-2bb1-5999-8774-d4c58e31f879") (property "Reference" "#PWR030" (at 22.86 232.41 0) (effects (font (size 1.27 1.27)) (justify left) (hide yes))) (property "Value" "GND" (at 22.86 234.95 0) (effects (font (size 1.27 1.27)) (justify left) (hide yes))) (property "Footprint" "" (at 20.32 233.68 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Datasheet" "" (at 20.32 233.68 0) (effects (font (size 1.27 1.27)) (hide yes))) (pin "1" (uuid "4aa969fb-339f-58ae-97d0-b60d60980ecf")) (instances (project "frontend_mod" (path "/6e728612-5e97-5188-b2b2-de4759c8c416" (reference "#PWR030") (unit 1))))) (text "ЧТО ПЕРЕПАЯТЬ (вокруг U3 = AD8138)" (exclude_from_sim no) (at 203.20 35.56 0) (effects (font (size 3.0 3.0) (bold yes) (color 200 0 0 1)) (justify left top)) (uuid "407c0820-44f6-508a-b3ee-b942359e8bef")) (text "1. Rser 200 Ом (последовательно от центра SMA)\n     ->  ВЫПАЯТЬ, поставить конденсатор 100 нФ\n     (развязка по постоянке: антенна с КЗ по DC не посадит смещение)\n2. Rsh 62 Ом (на землю после Rser)  ->  ОСТАВИТЬ\n     Zвх станет 62 || 360 = 53 Ом\n3. RG1, RG2 = 200 Ом (вход -> ножки 8 и 1 U3)  ->  360 Ом, ОБА (у IW5ALZ 390)\n4. RF1, RF2 = 200 Ом (обр. связь 5->8 и 4->1 U3)  ->  2.2 кОм, ОБА\n     RG и RF менять парами, иначе разбаланс (чётные гармоники)\n5. RBAL 50 Ом (RG2 -> RBAL -> земля)  ->  22 Ом (идеал 27.7; 22 ближе, чем 39)\n     балансирует -IN под сопротивление источника со стороны +IN:\n     было 62 || (200 + 50) = 49.7 Ом (отсюда 50), стало 62 || 50 = 27.7 Ом.\n     Оставить 50 можно - работает, но разбаланс ~5% (чуть хуже чётные гармоники)\n6. RC-фильтр U3 -> AD9226, VOCM (CML), питание  ->  НЕ ТРОГАТЬ\n\nУсиление (формула IW5ALZ):\n  было:  делитель (200||62)/(200 + 200||62) = 0.19,  x (200/200 + 1) = 0.38\n  стало: делителя нет,  2200/360 + 1 = 7.11  (у IW5ALZ 2200/390 + 1 = 6.64)" (exclude_from_sim no) (at 203.20 45.72 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid "2e2bad3c-fa87-53a1-9c0d-fd717f6dc60c")) (text "КАК НАЙТИ (питание ВЫКЛ., прозвонка)" (exclude_from_sim no) (at 203.20 127.00 0) (effects (font (size 3.0 3.0) (bold yes) (color 0 0 160 1)) (justify left top)) (uuid "6c42daca-904d-5438-8ee4-9cf72be0a686")) (text "Rser : один вывод звонится на центр SMA\nRsh  : один вывод на Rser, другой на землю\nRF   : соединяет ножки U3  1 <-> 4  или  8 <-> 5\nRG   : один вывод на ножку 1 или 8 U3, другой к Rsh или к RBAL\nRBAL : между RG2 и землёй (прозвонено: 50 Ом)\n\nПо фото маркировка 2000 (= 200 Ом): R2, R6, резистор справа от R6,\nR14, резистор над C14 - кандидаты в Rser / RG / RF.\nR16, R8, R17 (у SMA) и R9, R11 на фото не читаются.\nПОЗИЦИОННЫЕ НОМЕРА НЕ ПРОВЕРЕНЫ - СНАЧАЛА ПРОЗВОНИТЬ!\n\nЦоколёвка AD8138, SOIC-8 (точка/ключ = ножка 1):\n  1 -IN     2 VOCM    3 V+     4 +OUT\n  5 -OUT    6 V-      7 NC     8 +IN\n\nКакой вход (+IN или -IN) получает сигнал - неважно,\nкаскад симметричный, замена номиналов та же.\nДетали: 0603/0805, 1%;  C 100 нФ X7R." (exclude_from_sim no) (at 203.20 137.16 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid "c904d01c-ab31-57ac-aaa5-7efc21ac2b63")) (sheet_instances (path "/" (page "1"))))
