# ESP32-S3-N16R8 on the 44-pin DevKitC board (perfboard, 2026-11-08):
# 16MB quad flash, 8MB octal PSRAM (uses GPIO33..37).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
# GPIO20 (USB D+) is the FPGA SPI CS: no USB-Serial-JTAG console, the
# console and flashing use the COM port (CH343, GPIO43/44)
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
