#!/bin/bash
# Usage: ./build bars
#        ./build mandel [27|54|67]   (MHz of the PLL clock = SPI SCK, default 54)
#   bars   - colour bars / solid colours / gradients (tft_test_top.v, 27 MHz)
#   mandel - Mandelbrot zoom, 4 engines (mandel_top.v + mandel_engine.v)
# Output: build_out/<name>/impl/pnr/<name>.fs, name = bars | mandel<MHz>
set -e
P="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IDE_DIR="$HOME/gowin_eda/IDE"
export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libfreetype.so.6
export LD_LIBRARY_PATH="$IDE_DIR/lib:$LD_LIBRARY_PATH"
mkdir -p "$P/build_out"
case "${1:-mandel}" in
    bars)
        NAME=bars; TOP=tft_test_top; FILES="$P/tft_test_top.v" ;;
    mandel)
        MHZ="${2:-54}"
        # CLKOUT = 27*(FBDIV+1)/(IDIV+1), VCO = CLKOUT*ODIV must be 500..1250 MHz
        # Fmax of the design ~69-72 MHz (36x36 multiply chain) -> 81 fails timing
        case "$MHZ" in
            27) I=0; F=0; O=32; KHZ=27000 ;;
            54) I=0; F=1; O=16; KHZ=54000 ;;
            67) I=1; F=4; O=8;  KHZ=67500 ;;
            *) echo "MHz must be 27|54|67"; exit 1 ;;
        esac
        NAME=mandel$MHZ; TOP=${NAME}_wrap
        cat > "$P/build_out/${NAME}_wrap.v" <<EOV
// generated by ./build - $MHZ MHz PLL clock
module ${NAME}_wrap (input wire clk, input wire btn_s1, input wire btn_s2,
    output wire tft_sck, output wire tft_mosi, output wire tft_cs, output wire tft_dc, output wire tft_rst);
    mandel_top #(.CLK_KHZ($KHZ), .PLL_IDIV($I), .PLL_FBDIV($F), .PLL_ODIV($O), .PLL_BYPASS("false")) u (
        .clk_in(clk), .btn_s1(btn_s1), .btn_s2(btn_s2), .tft_sck(tft_sck), .tft_mosi(tft_mosi),
        .tft_cs(tft_cs), .tft_dc(tft_dc), .tft_rst(tft_rst));
endmodule
EOV
        FILES="$P/build_out/${NAME}_wrap.v $P/mandel_top.v $P/mandel_engine.v" ;;
    *) echo "Usage: $0 bars | mandel [27|54|67]"; exit 1 ;;
esac
TCL="$P/build_out/$NAME.tcl"
{
    echo "create_project -name $NAME -dir $P/build_out -pn GW2AR-LV18QN88C8/I7 -device_version C -force"
    for f in $FILES "$P/ili9341_driver.v" "$P/tft_test.cst" "$P/tft_test.sdc"; do echo "add_file $f"; done
    echo "set_option -top_module $TOP"
    echo "run all"
} > "$TCL"
"$IDE_DIR/bin/gw_sh" "$TCL"
echo
echo "Bitstream: $P/build_out/$NAME/impl/pnr/$NAME.fs"
