// Constraints for Sipeed Tang Nano 20K (GW2AR-LV18QN88C8/I7) - AD9226 test.
// Every pin checked against the official schematic
// docs/Tang_Nano_20K_3923_Schematics.pdf (sheet 1, headers J5/J6) - all are
// header-exposed, 3.3V banks. Wiring diagram: hardware/wiring/wiring.kicad_sch
// (generated by hardware/gen_wiring_sch.py - keep both in sync).
//
// Deliberately NOT used: 76/86 (driven by the onboard BL616 debugger),
// 49 (LCD backlight boost enable), 51/54/55/56 (onboard audio amplifier,
// reserved for SDR audio). Spare: 72 (J5-17, clean).
// ADC data inputs avoid LED pins (510R+LED to 3V3 = 2.5mA load) and the
// HDMI DDC 2.2k pull-ups; D3 (HPD divider) and D8 (SD 10k) are light loads.
//
// Perfboard layout (2026-11-01, shortest wires):
//       [ TFT above the Tang's top-right corner ]
//       ESP32-S3  |  Tang  |  AD9226 (SMA to the right)
// Tang mounted HDMI end UP: J5 = LEFT row (ESP side), J6 = RIGHT row (ADC
// side), pin 20 of both rows at the top.

IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Onboard buttons S1/S2 (active-high)
IO_LOC "btn_s1" 88;
IO_PORT "btn_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "btn_s2" 87;
IO_PORT "btn_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// ---- AD9226 module, P2 header facing J6 (+5V row at the top) ----------
// J6-14..J6-1 carry the module's signals in its own top-to-bottom order.
IO_LOC "adc_d[0]"    31;   // J6-14
IO_LOC "adc_d[1]"    30;   // J6-13
IO_LOC "adc_d[2]"    29;   // J6-12
IO_LOC "adc_d[3]"    26;   // J6-11  HDMI HPD 2.2k/5.1k divider (light load)
IO_LOC "adc_d[4]"    25;   // J6-10
IO_LOC "adc_d[5]"    28;   // J6-9
IO_LOC "adc_d[6]"    27;   // J6-8
IO_LOC "adc_clk"     16;   // J6-7   LED1 pin (output - LED glows)
IO_LOC "adc_otr"     15;   // J6-6   LED0 pin (lit while OTR=0 - static, harmless)
IO_LOC "adc_d[7]"    77;   // J6-5
IO_LOC "adc_d[8]"    85;   // J6-4   microSD D1, 10k pull-up - SD slot EMPTY
IO_LOC "adc_d[9]"    75;   // J6-3   BL616 SPI_MISO (BL616 only listens)
IO_LOC "adc_d[10]"   74;   // J6-2
IO_LOC "adc_d[11]"   73;   // J6-1
IO_PORT "adc_clk"   IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "adc_d[0]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[1]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[2]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[3]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[4]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[5]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[6]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[7]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[8]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[9]"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_otr"   IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---- ILI9341 SPI TFT, above the Tang ------------------- TFT header pin
//                                    J6-19 3V3 -> 1 VCC, 8 LED
//                                    J6-20 GND -> 2 GND
IO_LOC "tft_cs"   71;   // J5-18 -> 3 CS
IO_LOC "tft_rst"  18;   // J6-18 -> 4 RESET     (LED3 pin, flickers)
IO_LOC "tft_dc"   19;   // J6-17 -> 5 D/C       (LED4)
IO_LOC "tft_mosi" 20;   // J6-16 -> 6 SDI(MOSI) (LED5)
IO_LOC "tft_sck"  17;   // J6-15 -> 7 SCK       (LED2)
IO_PORT "tft_cs"   IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
IO_PORT "tft_rst"  IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
IO_PORT "tft_dc"   IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "tft_mosi" IO_TYPE=LVCMOS33 DRIVE=12;
IO_PORT "tft_sck"  IO_TYPE=LVCMOS33 DRIVE=12;

// ---- ESP32-S3 link (RESERVED - uncomment when the top has these ports) ----
// Revised 2026-11-08 (hardware/gen_wiring_sch.py ESP_LINK, perfboard photo
// Screenshots/photo_2026-11-08_22-27-08.jpg): ESP32-S3-DevKitC right row J3
// faces J5, J5-n sits opposite ESP J3-(23-n) -> straight jumpers. Plus GND
// J5-2 <-> J3-21 (J5-1 +5V faces ESP GND J3-22 - never bridge).
//   esp_sck   <- pin 53 J5-19  ESP GPIO1   (HDMI DDC SCL, 2.2k pull-up on board)
//   esp_miso  -> pin 71 J5-18  ESP GPIO2   (was tft_cs while the TFT is on the Tang)
//   esp_ws    -> pin 72 J5-17  ESP GPIO42
//   esp_mosi  <- pin 79 J5-14  ESP GPIO39  (WS2812 DIN - RGB LED may light randomly)
//   esp_bck   -> pin 41 J5-6   ESP GPIO47
//   esp_data  -> pin 42 J5-5   ESP GPIO21
//   esp_cs_n  <- pin 80 J5-4   ESP GPIO20  (microSD D2 10k pull-up keeps it high)
// The rotary encoder connects to the ESP, as in FpgaRX-SDR.
//IO_LOC "esp_sck"  53;
//IO_LOC "esp_mosi" 79;
//IO_LOC "esp_cs_n" 80;
//IO_LOC "esp_miso" 71;
//IO_LOC "esp_data" 42;
//IO_LOC "esp_ws"   72;
//IO_LOC "esp_bck"  41;
//IO_PORT "esp_sck"  IO_TYPE=LVCMOS33;
//IO_PORT "esp_mosi" IO_TYPE=LVCMOS33;
//IO_PORT "esp_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
//IO_PORT "esp_miso" IO_TYPE=LVCMOS33 DRIVE=8;
//IO_PORT "esp_data" IO_TYPE=LVCMOS33 DRIVE=8;
//IO_PORT "esp_ws"   IO_TYPE=LVCMOS33 DRIVE=8;
//IO_PORT "esp_bck"  IO_TYPE=LVCMOS33 DRIVE=8;
